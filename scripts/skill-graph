#!/usr/bin/env python3
"""Generate GRAPH.md: skill cross-reference diagrams.

A skill "references" another when its body contains the other's name in
backticks (`skill-name`). GRAPH.md gets one graphviz PNG per curated
complex workflow (nodes reachable from an entrypoint skill) plus one
mermaid diagram per category.

Also validates explicit skill handoffs: a phrase like "the `x` skill" or
"skill `x`" naming a skill that neither exists in this repo nor is a known
harness-provided skill fails the run (catches stale references after renames).

Usage:
  scripts/skill-graph           # validate and (re)write GRAPH.md
  scripts/skill-graph --images  # also render graphs/<root>.png (graphviz)
  scripts/skill-graph --check   # validate and fail if GRAPH.md is stale (CI)
"""

import re
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
OUTPUT = ROOT / "GRAPH.md"
GRAPHS_DIR = ROOT / "graphs"

# Curated complex workflows: (entrypoint skill, reachability depth, blurb).
WORKFLOWS = [
    ("idea-to-pr", 1,
     "End-to-end feature delivery: discovery, planning, build, and PR."),
    ("pr", 2,
     "PR lifecycle: prepare the branch, create the PR, and reconcile it"
     " through review and CI."),
    ("plan-init", 1,
     "Planning artifacts: from plan folder to slices, specs, and design"
     " documents."),
    ("new-app", 2,
     "New project: local scaffold, GitHub repo with policy, Orca"
     " registration, and worktree environments."),
    ("visual-capture", 1,
     "UI evidence: screenshots and clips captured and attached to PRs."),
    ("gh-stack", 1,
     "Stacked PRs: stack management with rebase and conflict handling."),
]

PALETTE = ["#e3f2fd", "#e8f5e9", "#fff3e0", "#f3e5f5", "#e0f7fa", "#fce4ec",
           "#f1f8e9", "#ede7f6", "#fffde7", "#efebe9", "#e8eaf6"]

# Skills provided by agent harnesses, not by this repository.
EXTERNAL = {"orca-cli", "computer-use"}

SKILL_CONTEXT = re.compile(
    r"(?:skills?\s+(?:named\s+)?`([\w-]+)`)"
    r"|(?:`([\w-]+)`(?:\s+and\s+`([\w-]+)`)?\s+skills?)"
    r"|(?:(?:invokes?|invoking|loads?|loading)\s+(?:the\s+)?`([\w-]+)`)",
    re.I,
)


def load_skills():
    """Return {name: (category, body)} for every skills/**/SKILL.md."""
    skills = {}
    for path in sorted((ROOT / "skills").rglob("SKILL.md")):
        parts = path.read_text().split("---", 2)
        if len(parts) < 3:
            sys.exit(f"error: {path}: missing frontmatter")
        match = re.search(r"^name: (\S+)", parts[1], re.M)
        if not match:
            sys.exit(f"error: {path}: missing frontmatter name")
        category = path.parent.parent.name
        skills[match.group(1)] = (category, parts[2])
    return skills


def extract_edges(skills):
    edges = []
    for name, (_, body) in skills.items():
        for other in skills:
            if other != name and re.search(rf"`{re.escape(other)}`", body):
                edges.append((name, other))
    return sorted(edges)


def validate(skills):
    """Fail on explicit skill references that resolve to nothing."""
    dangling = []
    for name, (_, body) in skills.items():
        for match in SKILL_CONTEXT.finditer(body):
            for ref in match.groups():
                if ref and ref not in skills and ref not in EXTERNAL:
                    dangling.append((name, ref))
    if dangling:
        for name, ref in sorted(set(dangling)):
            print(f"error: {name}: references unknown skill `{ref}`",
                  file=sys.stderr)
        sys.exit(1)


def render(skills, edges):
    category_of = {name: cat for name, (cat, _) in skills.items()}
    categories = sorted({cat for cat, _ in skills.values()})
    lines = [
        "# Skill Graph",
        "",
        "Which skills reference which. Generated by `scripts/skill-graph`;",
        "do not edit by hand.",
        "",
        f"{len(skills)} skills, {len(edges)} references.",
        "",
        "## Workflows",
        "",
        "The most complex workflows, one graph each. The yellow node is the",
        "workflow's entrypoint; every other node is reachable from it.",
        "",
    ]
    for root, _, blurb in WORKFLOWS:
        lines += [f"### {root}", "", blurb, "",
                  f"![{root} workflow](graphs/{root}.png)", ""]
    lines += [
        "## By category",
        "",
        "Solid arrows stay inside a category; dotted arrows cross category",
        "boundaries. Each diagram shows every edge touching its category.",
        "",
    ]
    for cat in categories:
        members = sorted(n for n, c in category_of.items() if c == cat)
        intra = [(a, b) for a, b in edges
                 if category_of[a] == cat and category_of[b] == cat]
        cross = [(a, b) for a, b in edges
                 if (category_of[a] == cat) != (category_of[b] == cat)]
        lines += [f"## {cat}", "", "```mermaid", "graph LR",
                  f"    subgraph {cat}"]
        linked = {n for e in intra for n in e}
        for name in members:
            if name not in linked:
                lines.append(f"        {name}")
        for a, b in intra:
            lines.append(f"        {a} --> {b}")
        lines.append("    end")
        for a, b in cross:
            lines.append(f"    {a} -.-> {b}")
        lines += ["```", ""]
    return "\n".join(lines)


def reachable(adjacency, category_of, root, depth):
    """Nodes within `depth` hops of root, expanding only through nodes in
    the root's own category so a workflow does not absorb its neighbors'
    workflows; foreign skills appear as one-hop leaves."""
    home = category_of[root]
    nodes, frontier = {root}, {root}
    for _ in range(depth):
        frontier = {b for a in frontier if category_of[a] == home
                    for b in adjacency.get(a, ())} - nodes
        nodes |= frontier
    return nodes


def render_workflow_dot(root, depth, skills, edges):
    category_of = {name: cat for name, (cat, _) in skills.items()}
    categories = sorted({cat for cat, _ in skills.values()})
    color = {cat: PALETTE[i % len(PALETTE)]
             for i, cat in enumerate(categories)}
    adjacency = {}
    for a, b in edges:
        adjacency.setdefault(a, set()).add(b)
    nodes = reachable(adjacency, category_of, root, depth)
    out = [
        "digraph workflow {",
        "  rankdir=LR;",
        f'  label="{root}"; labelloc=t; fontsize=16; fontname="Helvetica";',
        '  node [shape=box, style="rounded,filled", fontname="Helvetica",'
        ' fontsize=11, margin="0.15,0.08"];',
        '  edge [color="#607d8b", arrowsize=0.7];',
    ]
    for name in sorted(nodes):
        fill = ("#fff176" if name == root
                else color[category_of[name]])
        pen = ", penwidth=2" if name == root else ""
        out.append(f'  "{name}" [fillcolor="{fill}"{pen}];')
    for a, b in edges:
        if a in nodes and b in nodes:
            out.append(f'  "{a}" -> "{b}";')
    out.append("}")
    return "\n".join(out)


def write_images(skills, edges):
    if not shutil.which("dot"):
        sys.exit("error: --images requires graphviz (dot) on PATH")
    GRAPHS_DIR.mkdir(exist_ok=True)
    for root, depth, _ in WORKFLOWS:
        output = GRAPHS_DIR / f"{root}.png"
        result = subprocess.run(
            ["dot", "-Tpng", "-o", str(output)],
            input=render_workflow_dot(root, depth, skills, edges),
            text=True, capture_output=True)
        if result.returncode != 0:
            sys.exit(f"error: dot failed for {root}:\n{result.stderr}")
        print(f"wrote {output.relative_to(ROOT)}")


def main():
    skills = load_skills()
    validate(skills)
    edges = extract_edges(skills)
    content = render(skills, edges)
    if "--check" in sys.argv[1:]:
        if not OUTPUT.exists() or OUTPUT.read_text() != content:
            sys.exit("error: GRAPH.md is stale; run scripts/skill-graph")
        print("GRAPH.md is up to date")
        return
    OUTPUT.write_text(content)
    print(f"wrote {OUTPUT.relative_to(ROOT)}")
    if "--images" in sys.argv[1:]:
        write_images(skills, edges)


if __name__ == "__main__":
    main()
