#!/usr/bin/env python3
"""Generate GRAPH.md: per-category mermaid diagrams of skill cross-references.

A skill "references" another when its body contains the other's name in
backticks (`skill-name`). Edges inside a category are solid; edges crossing
categories are dotted. Each category diagram shows every edge touching it.

Also validates explicit skill handoffs: a phrase like "the `x` skill" or
"skill `x`" naming a skill that neither exists in this repo nor is a known
harness-provided skill fails the run (catches stale references after renames).

Usage:
  scripts/skill-graph          # validate and (re)write GRAPH.md
  scripts/skill-graph --check  # validate and fail if GRAPH.md is stale (CI)
"""

import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
OUTPUT = ROOT / "GRAPH.md"

# Skills provided by agent harnesses, not by this repository.
EXTERNAL = {"orca-cli", "computer-use"}

SKILL_CONTEXT = re.compile(
    r"(?:skills?\s+(?:named\s+)?`([\w-]+)`)"
    r"|(?:`([\w-]+)`(?:\s+and\s+`([\w-]+)`)?\s+skills?)"
    r"|(?:(?:invokes?|invoking|loads?|loading)\s+(?:the\s+)?`([\w-]+)`)",
    re.I,
)


def load_skills():
    """Return {name: (category, body)} for every skills/**/SKILL.md."""
    skills = {}
    for path in sorted((ROOT / "skills").rglob("SKILL.md")):
        parts = path.read_text().split("---", 2)
        if len(parts) < 3:
            sys.exit(f"error: {path}: missing frontmatter")
        match = re.search(r"^name: (\S+)", parts[1], re.M)
        if not match:
            sys.exit(f"error: {path}: missing frontmatter name")
        category = path.parent.parent.name
        skills[match.group(1)] = (category, parts[2])
    return skills


def extract_edges(skills):
    edges = []
    for name, (_, body) in skills.items():
        for other in skills:
            if other != name and re.search(rf"`{re.escape(other)}`", body):
                edges.append((name, other))
    return sorted(edges)


def validate(skills):
    """Fail on explicit skill references that resolve to nothing."""
    dangling = []
    for name, (_, body) in skills.items():
        for match in SKILL_CONTEXT.finditer(body):
            for ref in match.groups():
                if ref and ref not in skills and ref not in EXTERNAL:
                    dangling.append((name, ref))
    if dangling:
        for name, ref in sorted(set(dangling)):
            print(f"error: {name}: references unknown skill `{ref}`",
                  file=sys.stderr)
        sys.exit(1)


def render(skills, edges):
    category_of = {name: cat for name, (cat, _) in skills.items()}
    categories = sorted({cat for cat, _ in skills.values()})
    lines = [
        "# Skill Graph",
        "",
        "Which skills reference which. Generated by `scripts/skill-graph`;",
        "do not edit by hand.",
        "",
        f"{len(skills)} skills, {len(edges)} references. Solid arrows stay",
        "inside a category; dotted arrows cross category boundaries. Each",
        "diagram shows every edge touching its category.",
        "",
    ]
    for cat in categories:
        members = sorted(n for n, c in category_of.items() if c == cat)
        intra = [(a, b) for a, b in edges
                 if category_of[a] == cat and category_of[b] == cat]
        cross = [(a, b) for a, b in edges
                 if (category_of[a] == cat) != (category_of[b] == cat)]
        lines += [f"## {cat}", "", "```mermaid", "graph LR",
                  f"    subgraph {cat}"]
        linked = {n for e in intra for n in e}
        for name in members:
            if name not in linked:
                lines.append(f"        {name}")
        for a, b in intra:
            lines.append(f"        {a} --> {b}")
        lines.append("    end")
        for a, b in cross:
            lines.append(f"    {a} -.-> {b}")
        lines += ["```", ""]
    return "\n".join(lines)


def main():
    skills = load_skills()
    validate(skills)
    content = render(skills, extract_edges(skills))
    if "--check" in sys.argv[1:]:
        if not OUTPUT.exists() or OUTPUT.read_text() != content:
            sys.exit("error: GRAPH.md is stale; run scripts/skill-graph")
        print("GRAPH.md is up to date")
    else:
        OUTPUT.write_text(content)
        print(f"wrote {OUTPUT.relative_to(ROOT)}")


if __name__ == "__main__":
    main()
