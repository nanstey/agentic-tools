+
+function freshSpawnTypeError(type: string, resume: unknown): string | undefined {
+  if (resume || isManagedDelegationType(type)) return undefined;
+  return `Only managed delegation-* profiles may spawn agents; refused "${type}".`;
+}
+
+function managedProjectSettingsError(cwd: string): string | undefined {
+  const path = join(cwd, ".pi", "subagents.json");
+  if (!existsSync(path)) return undefined;
+  let projectSettings: unknown;
+  try {
+    projectSettings = JSON.parse(readFileSync(path, "utf8"));
+  } catch {
+    return `Cannot verify project delegation settings at ${path}; refusing managed delegation.`;
+  }
+  if (!projectSettings || typeof projectSettings !== "object" || Array.isArray(projectSettings)) {
+    return `Project delegation settings at ${path} must be an object.`;
+  }
+  for (const [key, value] of Object.entries(MANAGED_SECURITY_SETTINGS)) {
+    if (Object.hasOwn(projectSettings, key) && JSON.stringify((projectSettings as Record<string, unknown>)[key]) !== JSON.stringify(value)) {
+      return `Project subagents.json conflicts with the global managed setting "${key}".`;
+    }
+  }
+  return undefined;
+}
+
+function isManagedGlobalProfile(type: string, config: AgentConfig | undefined): boolean {
+  if (config?.source !== "global" || !config.sourcePath) return false;
+  const expected = join(getAgentDir(), "agents", `${type}.md`);
+  try {
+    return existsSync(expected) && realpathSync(config.sourcePath) === realpathSync(expected);
+  } catch {
+    return false;
+  }
+}
+
+function managedDelegationPolicyError(
+  type: string,
+  params: { model?: unknown; thinking?: unknown },
+  config: AgentConfig | undefined,
+  cwd: string,
+): string | undefined {
+  if (params.model == null || params.thinking == null) {
+    return `Managed delegation type "${type}" requires explicit model and thinking.`;
+  }
+  if (!isManagedGlobalProfile(type, config)) {
+    return `Managed delegation type "${type}" must originate from the global managed agents directory.`;
+  }
+  if (config?.model != null) return `Managed delegation type "${type}" must not pin a model.`;
+  if (config?.thinking != null) return `Managed delegation type "${type}" must not pin thinking.`;
+  if (!MANAGED_DELEGATION_MODELS.has(params.model as string)) {
+    return `Model is outside the managed delegation policy: "${String(params.model)}".`;
+  }
+  if (typeof params.thinking !== "string" || !MANAGED_DELEGATION_SELECTIONS[type].has(`${params.model}|${params.thinking}`)) {
+    return `Model/thinking selection is outside the managed delegation policy: "${String(params.model)}" / "${String(params.thinking)}".`;
+  }
+  return managedProjectSettingsError(cwd);
+}
+
+/** Resolve a caller-selected model without aliases or unauthenticated fallbacks. */
+function resolveExactAvailableModel(input: unknown, registry: ModelRegistry): { model?: any; error?: string } {
+  if (typeof input !== "string" || !/^[^/\s]+\/[^/\s]+$/.test(input)) {
+    return { error: `Model must be an exact provider/modelId: "${String(input)}".` };
+  }
+  const getAvailable = registry.getAvailable;
+  if (typeof getAvailable !== "function") {
+    return { error: "Cannot verify model availability; refusing delegation dispatch." };
+  }
+  const [provider, id] = input.split("/");
+  const available = getAvailable.call(registry) as Array<{ provider: string; id: string }>;
+  if (!available.some((candidate) => candidate.provider === provider && candidate.id === id)) {
+    return { error: `Model is unavailable or unauthenticated: "${input}".` };
+  }
+  const model = registry.find(provider, id);
+  return model ? { model } : { error: `Model is unavailable or unauthenticated: "${input}".` };
+}
+
+function managedThinkingError(model: any, thinking: unknown): string | undefined {
+  if (typeof thinking !== "string" || !model || !getSupportedThinkingLevels(model).includes(thinking as any)) {
+    return `Thinking level "${String(thinking)}" is not supported by "${model ? `${model.provider}/${model.id}` : "the selected model"}".`;
+  }
+  return undefined;
+}
+
+/** Requested, pre-spawn, and effective-at-start selections for coordination evidence. */
+function modelProvenance(invocation: AgentInvocation | undefined) {
+  if (!invocation) return undefined;
+  const selection = (model: string | undefined, thinking: string | undefined) =>
+    model === undefined && thinking === undefined ? undefined : {
+      ...(model !== undefined ? { model } : {}),
+      ...(thinking !== undefined ? { thinking } : {}),
+    };
+  const effectiveAtStart = selection(invocation.modelId, invocation.thinking);
+  return {
+    requested: selection(invocation.requestedModel, invocation.requestedThinking),
+    initial: selection(invocation.initialModelId, invocation.initialThinking),
+    // agent-manager updates this when the session starts. Completion does not
+    // prove it remained unchanged for every later request.
+    final: effectiveAtStart && { ...effectiveAtStart, evidence: "effective-at-start" },
+  };
+}
