+function userOwnedText(prompt: string): string {
+  let text = prompt;
+  text = text.replace(/<([A-Za-z][\w:-]*)(?:\s[^>]*)?>[\s\S]*?<\/\1\s*>/gi, "");
+  text = text.replace(/<(?:skill|context|handoff)\b(?:\s[^>]*)?>[\s\S]*$/gi, "");
