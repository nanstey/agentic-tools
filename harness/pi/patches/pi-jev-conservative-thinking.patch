+  )).join("\n");
+  return text.replace(/"[^"\n]*"|“[^”\n]*”|`[^`\n]*`/g, "").trim();
+}
+
+export function classifyConservative(prompt: string | undefined): ThinkingNeed {
+  const text = userOwnedText(prompt ?? "");
+  if (!text) return { level: "medium", confidence: 0.5, reason: "no user-owned text" };
+  if (!NEGATED_XHIGH.test(text) && EXPLICIT_XHIGH.test(text)) return { level: "xhigh", confidence: 0.9, reason: "explicit xhigh request", explicit: true };
+  if (DEESCALATE.test(text) && text.length < SHORT_PROMPT_CHARS) {
+    return { level: "minimal", confidence: 0.75, reason: "short mechanical task" };
+  }
+  if (text.length <= 600 && HIGH_INTENT.test(text)) {
+    return { level: "high", confidence: 0.8, reason: "focused debugging, security, or investigation task" };
+  }
+  return { level: "medium", confidence: 0.55, reason: "general user task" };
+}
