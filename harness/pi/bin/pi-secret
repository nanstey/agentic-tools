#!/usr/bin/env bash
# pi-secret — manage per-auth-profile secrets (env vars) for Pi.
# Store: $PI_AGENT_DIR/secrets/<profile>.env, NAME=value lines, mode 600.
# The profile-secrets extension exports them while that auth profile is active.
set -euo pipefail

AGENT_DIR="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}"
DIR="$AGENT_DIR/secrets"

usage() {
  cat >&2 <<'USAGE'
pi-secret — per-auth-profile secrets (environment variables) for Pi

Usage: pi-secret [-p PROFILE] <command>

Commands:
  set NAME        store a secret; prompts without echo, or reads one line from stdin
  unset NAME      remove a secret
  list            list secret names for the profile (never values)
  list --all      list secret names for every profile
  profile         print the resolved profile
  help, -h        show this help

Profile (first match wins): -p PROFILE; "authProfile" in ./.pi/settings.json;
"defaultProfile" in ~/.pi/agent/auth-profiles.json; "default".

Secrets live in ~/.pi/agent/secrets/<profile>.env (mode 600). While that auth
profile is active, the profile-secrets Pi extension exports them as environment
variables (e.g. OPENROUTER_API_KEY or TYPESAFE_API_KEY for codemode Jev); changes apply within moments (file watch).
NAME is [A-Za-z_][A-Za-z0-9_]*; values are single-line. Run `set` from a normal
terminal, not inside Pi, so the value stays out of the session transcript.

Examples:
  pi-secret -p work set TYPESAFE_API_KEY
  pi-secret -p work list
  pi-secret list --all
  pi-secret -p work unset TYPESAFE_API_KEY
USAGE
}

json_field() { # file key
  [ -f "$1" ] && jq -r --arg k "$2" '.[$k] // empty' "$1" 2>/dev/null || true
}

case "${1:-}" in help|-h|--help) usage; exit 0 ;; esac
profile=""
if [ "${1:-}" = "-p" ]; then [ $# -ge 2 ] || { usage; exit 2; }; profile="$2"; shift 2; fi
if [ -z "$profile" ]; then
  profile="$(json_field .pi/settings.json authProfile)"
  [ -n "$profile" ] || profile="$(json_field "$AGENT_DIR/auth-profiles.json" defaultProfile)"
  [ -n "$profile" ] || profile=default
fi
profile="$(printf '%s' "$profile" | xargs)"  # trim, as auth-profiles does
[[ "$profile" =~ ^[A-Za-z0-9._-]+$ && "$profile" != . && "$profile" != .. ]] \
  || { echo "pi-secret: invalid profile '$profile'" >&2; exit 1; }
file="$DIR/$profile.env"

valid_name() { [[ "$1" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || { echo "pi-secret: invalid name '$1'" >&2; exit 1; }; }

# Rewrite the file without NAME, then optionally append NAME=value.
write_entry() { # name [value]
  umask 077
  mkdir -p "$DIR"
  local tmp; tmp="$(mktemp "$DIR/.tmp.XXXXXX")"
  trap "rm -f '$tmp'" EXIT
  { [ -f "$file" ] && grep -v "^$1=" "$file" || true; } > "$tmp"
  [ $# -lt 2 ] || printf '%s=%s\n' "$1" "$2" >> "$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$file"
}

cmd="${1:-}"; [ -n "$cmd" ] || { usage; exit 2; }; shift
case "$cmd" in
  set)
    [ $# -eq 1 ] || { usage; exit 2; }  # no positional VALUE: it would land in argv and shell history
    name="$1"; valid_name "$name"
    if [ -t 0 ]; then read -rsp "Value for $name [$profile]: " value; echo >&2
    else
      IFS= read -r value || true
      if IFS= read -r extra || [ -n "${extra:-}" ]; then echo "pi-secret: multi-line values unsupported" >&2; exit 1; fi
    fi
    [ -n "$value" ] || { echo "pi-secret: empty value" >&2; exit 1; }
    write_entry "$name" "$value"
    echo "set $name for profile '$profile'" >&2 ;;
  unset)
    [ $# -ge 1 ] || { usage; exit 2; }; valid_name "$1"
    [ -f "$file" ] && write_entry "$1"
    echo "unset $1 for profile '$profile'" >&2 ;;
  list)
    if [ "${1:-}" = "--all" ]; then
      for f in "$DIR"/*.env; do
        [ -f "$f" ] || continue
        printf '%s: %s\n' "$(basename "$f" .env)" "$(cut -d= -f1 "$f" | paste -sd' ' -)"
      done
    else
      [ -f "$file" ] && cut -d= -f1 "$file" || true
    fi ;;
  profile) echo "$profile" ;;
  help) usage ;;
  *) usage; exit 2 ;;
esac
